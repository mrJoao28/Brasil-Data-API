# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Global request rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Per-plan request rate limits
RATE_LIMIT_FREE_MAX=5
RATE_LIMIT_PAID_MAX=120

# Monthly usage quotas
PLAN_FREE_MONTHLY_QUOTA=3000
PLAN_PAID_MONTHLY_QUOTA=100000

# API keys (comma-separated). No database is required.
API_KEYS_FREE=
API_KEYS_PAID=
# Put compromised/retired keys here before rotating them.
API_KEYS_REVOKED=

# Optional production state store. When configured, monthly usage and rate limits
# are shared across all API instances and survive restarts/deploys.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Outbound provider timeout/retry policy
HTTP_TIMEOUT_MS=8000
PROVIDER_RETRY_COUNT=2
PROVIDER_RETRY_BASE_DELAY_MS=250
PROVIDER_RETRY_MAX_DELAY_MS=2000

# Provider circuit breaker
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_MS=30000

# External provider base URLs
VIACEP_BASE_URL=https://viacep.com.br/ws
IBGE_LOCALIDADES_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
BRASILAPI_BASE_URL=https://brasilapi.com.br/api
OPENCNPJ_BASE_URL=https://api.opencnpj.org

CEP_PROVIDER=viacep
# CEP_PROVIDER=correios
CNPJ_PROVIDER=failover
# CNPJ_PROVIDER=brasilapi
# CNPJ_PROVIDER=opencnpj
# CNPJ_PROVIDER=receita-federal
