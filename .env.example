# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# Rate limiting (baseline limiter, applies to every request incl. /health)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Per-tier rate limits for authenticated /api/v1 requests (same window as
# RATE_LIMIT_WINDOW_MS above).
RATE_LIMIT_FREE_MAX=60
RATE_LIMIT_PAID_MAX=1000

# API keys per tier (comma-separated). No database yet in this MVP: keys
# live here until a real key-management store is introduced. A request to
# /api/v1/* without a valid key in one of these lists gets 401 UNAUTHORIZED.
API_KEYS_FREE=
API_KEYS_PAID=

# Outbound HTTP timeout (ms) when calling external providers
HTTP_TIMEOUT_MS=8000

# External provider base URLs
VIACEP_BASE_URL=https://viacep.com.br/ws
IBGE_LOCALIDADES_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# Provider selection for CEP and CNPJ lookups. Only the defaults below are
# actually implemented; the other listed values are documented extension
# points that fail fast with a clear error if selected, because they
# require credentials/contracts this project does not have configured.
# See docs/PROVIDERS.md before changing these, especially for a paid/
# commercial deployment.
CEP_PROVIDER=viacep
# CEP_PROVIDER=correios      # not implemented - requires a SIGEP Web contract
CNPJ_PROVIDER=brasilapi
# CNPJ_PROVIDER=receita-federal  # not implemented - requires gov.br/conecta OAuth2 credentials
